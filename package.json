{
  "name": "talentbridge",
  "version": "1.0.0",
  "description": "TalentBridge - AI Recruitment Platform",
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "dev:ai": "cd ai-service && .\\venv\\Scripts\\activate && uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:ai\"",
    "install:all": "npm install && cd web && npm install && cd ../ai-service && python -m venv venv && .\\venv\\Scripts\\activate && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
